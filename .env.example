# Endpoint compatible con OpenAI Responses API
LLM_BASE_URL=https://api.sub2apidavid.online
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
LLM_WIRE_API=responses
LLM_STORE_RESPONSES=false

# BigQuery usa Application Default Credentials del runtime actual
BQ_JOB_PROJECT=sbscol-dbreplication-prd
BQ_LOCATION=
BQ_SEED_PROJECTS=centralizacion-datos,sbscol-dbreplication-prd
BQ_PAGE_SIZE=500

# audit muestra SQL, jobs y tiempos durante la POC; business deja solo la respuesta de negocio.
ANALYTICS_AGENT_PRESENTATION=audit

# Memoria local, separada por cuenta del sistema en Workbench.
# Por defecto: ~/.local/share/analytics-agent/state.sqlite3
# ANALYTICS_AGENT_STATE_DIR=

# Diccionario opcional: si no se puede leer, el agente continúa con BigQuery
SCHEMA_WORKBOOK_GCS_URI=gs://buckets-analytics-staging/proyectos/librerias/diccionario_tablas.xlsx
SCHEMA_WORKBOOK=
